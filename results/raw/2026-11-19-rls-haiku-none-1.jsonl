{"type":"assistant","message":{"model":"claude-haiku-5-5","id":"msg_011ChBzD7Kq1y1jSN7GcUzvD","type":"message","role":"assistant","content":[{"type":"text","text":"```sql\nDO $$\nDECLARE\n  has_user_id boolean;\nBEGIN\n  SELECT EXISTS (\n    SELECT 1\n    FROM information_schema.columns\n    WHERE table_schema = 'public'\n      AND table_name = 'orders'\n      AND column_name = 'user_id'\n  ) INTO has_user_id;\n\n  -- Turn on RLS for orders (deny-by-default for non-owners).\n  ALTER TABLE public.orders ENABLE ROW LEVEL SECURITY;\n\n  DROP POLICY IF EXISTS orders_select_own ON public.orders;\n\n  -- Owner is orders.user_id if present; otherwise orders.customer_id -> customers.user_id.\n  IF has_user_id THEN\n    EXECUTE 'CREATE POLICY orders_select_own ON public.orders\n             FOR SELECT TO authenticated\n             USING (user_id = auth.uid())';\n  ELSE\n    EXECUTE 'CREATE POLICY orders_select_own ON public.orders\n             FOR SELECT TO authenticated\n             USING (customer_id IN (\n               SELECT c.id FROM public.customers c WHERE c.user_id = auth.uid()\n             ))';\n  END IF;\nEND\n$$;\n```"}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":0,"cache_read_input_tokens":12990,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"24eea5ad-7983-4732-86fb-eeb78f05e4dc","uuid":"24dfeb6d-bcf3-434d-8846-f76b605fca35","timestamp":"2026-11-19T08:40:38.228Z","request_id":"req_011ChBzD72E7HVRnny5Vzn8K"}
